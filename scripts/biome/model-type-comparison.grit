language js

// Missing type.
or {
	`$model.type === "chat"`,
	`$model.type !== "chat"`,
	`$model.type == "chat"`,
	`$model.type != "chat"`,
	`"chat" === $model.type`,
	`"chat" !== $model.type`
} as $comparison where {
	register_diagnostic(
		span = $comparison,
		message = "Chat models may omit type. Use isModelType(model, 'chat') or getModelType(model) instead of comparing type to 'chat'."
	)
}

{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@huranth/gama-bus": ["./packages/bus/src/index.ts"],
			"@huranth/gama-bus/bundler": ["./packages/bus/src/bundler.ts"],
			"@huranth/gama-bus/context": ["./packages/bus/src/scope/index.ts"],
			"@huranth/gama-bus/delta": ["./packages/bus/src/patch/index.ts"],
			"@huranth/gama-bus/node": ["./packages/bus/src/host.ts"],
			"@huranth/gama-telemetry": ["./packages/trace/src/index.ts"],
			"@huranth/gama-telemetry/testing": ["./packages/trace/src/probe/index.ts"],
			"@huranth/gama-codemode": ["./packages/script/src/index.ts"],
			"@huranth/gama-codemode/types": ["./packages/script/src/types.ts"],
			"@huranth/gama-codemode/tools": ["./packages/script/src/tools.ts"],
			"@huranth/gama-codemode/worker": ["./packages/script/src/sandbox/worker.ts"],
			"@huranth/gama-codemode/declarations": ["./packages/script/src/types.ts"],
			"@huranth/gama-codemode/source": ["./packages/script/src/tools.ts"],
			"@huranth/gama-ai": ["./packages/model/src/index.ts"],
			"@huranth/gama-ai/models": ["./packages/model/src/registry.ts"],
			"@huranth/gama-ai/*": ["./packages/model/src/*.ts", "./packages/model/src/catalog/*.ts"],
			"@huranth/gama-durable": ["./packages/store/src/index.ts"],
			"@huranth/gama-durable/testing": ["./packages/store/src/testing/index.ts"],
			"@huranth/gama-durable/env": ["./packages/store/src/system/index.ts"],
			"@huranth/gama-durable/env/node": ["./packages/store/src/system/node.ts"],
			"@huranth/gama-durable/tools": ["./packages/store/src/ops/index.ts"],
			"@huranth/gama-durable/storage/memory": ["./packages/store/src/backends/memory.ts"],
			"@huranth/gama-durable/storage/jsonl": [
				"./packages/store/src/backends/jsonl/index.ts"
			],
			"@huranth/gama-durable/storage/jsonl/node": [
				"./packages/store/src/backends/jsonl/node.ts"
			],
			"@huranth/gama-durable/storage/sqlite": [
				"./packages/store/src/backends/sqlite/index.ts"
			],
			"@huranth/gama-durable/storage/sqlite/node": [
				"./packages/store/src/backends/sqlite/node.ts"
			],
			"@huranth/gama-durable/*": [
				"./packages/store/src/*.ts",
				"./packages/store/src/*/index.ts",
				"./packages/store/src/*"
			],
			"@huranth/gama-agent-core": ["./packages/loop/src/index.ts"],
			"@huranth/gama-harness": ["./packages/cli/src/index.ts"],
			"@huranth/gama-harness/experimental/plugin": [
				"./packages/cli/src/experimental/plugin.ts"
			],
			"@huranth/gama-harness/hooks": ["./packages/cli/src/core/hooks/index.ts"],
			"@huranth/gama-harness/*": ["./packages/cli/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@huranth/gama-tui": ["./packages/ui/src/index.ts"],
			"@huranth/gama-tui/*": ["./packages/ui/src/*"]
		}
	},
	"include": ["update/**/*.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/cli/examples/**/*"],
	"exclude": ["**/dist/**"]
}

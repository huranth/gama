{
	"name": "@huranth/gama-telemetry",
	"version": "1.0.3",
	"private": true,
	"description": "Telemetry contracts for Gama",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"source": "./src/probe/index.ts",
			"types": "./dist/probe/index.d.ts",
			"import": "./dist/probe/index.js",
			"default": "./dist/probe/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"telemetry",
		"tracing",
		"observability"
	],
	"author": "huranth",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/huranth/gama.git",
		"directory": "packages/trace"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.11"
	}
}

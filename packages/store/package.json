{
	"name": "@huranth/gama-durable",
	"version": "1.0.3",
	"private": true,
	"description": "Durable conversations, tasks, and documents",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./env": {
			"source": "./src/system/index.ts",
			"types": "./dist/system/index.d.ts",
			"import": "./dist/system/index.js",
			"default": "./dist/system/index.js"
		},
		"./env/node": {
			"source": "./src/system/node.ts",
			"types": "./dist/system/node.d.ts",
			"import": "./dist/system/node.js",
			"default": "./dist/system/node.js"
		},
		"./tools": {
			"source": "./src/ops/index.ts",
			"types": "./dist/ops/index.d.ts",
			"import": "./dist/ops/index.js",
			"default": "./dist/ops/index.js"
		},
		"./storage/memory": {
			"source": "./src/backends/memory.ts",
			"types": "./dist/backends/memory.d.ts",
			"import": "./dist/backends/memory.js",
			"default": "./dist/backends/memory.js"
		},
		"./storage/jsonl": {
			"source": "./src/backends/jsonl/index.ts",
			"types": "./dist/backends/jsonl/index.d.ts",
			"import": "./dist/backends/jsonl/index.js",
			"default": "./dist/backends/jsonl/index.js"
		},
		"./storage/jsonl/node": {
			"source": "./src/backends/jsonl/node.ts",
			"types": "./dist/backends/jsonl/node.d.ts",
			"import": "./dist/backends/jsonl/node.js",
			"default": "./dist/backends/jsonl/node.js"
		},
		"./storage/sqlite": {
			"source": "./src/backends/sqlite/index.ts",
			"types": "./dist/backends/sqlite/index.d.ts",
			"import": "./dist/backends/sqlite/index.js",
			"default": "./dist/backends/sqlite/index.js"
		},
		"./storage/sqlite/node": {
			"source": "./src/backends/sqlite/node.ts",
			"types": "./dist/backends/sqlite/node.d.ts",
			"import": "./dist/backends/sqlite/node.js",
			"default": "./dist/backends/sqlite/node.js"
		},
		"./testing": {
			"source": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js",
			"default": "./dist/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"bench:storage": "vitest bench --config vitest.benchmark.config.ts",
		"bench:storage:memory": "node --conditions=source --experimental-strip-types test/bench-memory.ts",
		"bench:tool-output": "node --conditions=source --experimental-strip-types --expose-gc test/tool-output-bench.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"durable-execution",
		"agents",
		"conversations",
		"tasks"
	],
	"author": "huranth",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/huranth/gama.git",
		"directory": "packages/store"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@huranth/gama-bus": "^1.0.3",
		"@huranth/gama-ai": "^1.0.3",
		"diff": "8.0.4",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.11"
	}
}

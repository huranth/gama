{
	"name": "@huranth/gama-tui",
	"version": "1.0.3",
	"private": true,
	"description": "Terminal interface toolkit for Gama",
	"type": "module",
	"main": "dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:linux": "native/linux/build.sh",
		"build:native:win32": "node native/win32/build.mjs",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"files": [
		"dist/**/*",
		"native/napi.h",
		"native/clipboard.h",
		"native/win32/prebuilds/**/*.node",
		"native/win32/src/**/*.c",
		"native/win32/build.mjs",
		"native/darwin/prebuilds/**/*.node",
		"native/darwin/src/**/*.m",
		"native/darwin/build.sh",
		"native/linux/prebuilds/**/*.node",
		"native/linux/src/**/*.{c,h}",
		"native/linux/build.sh",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "huranth",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/huranth/gama.git",
		"directory": "packages/ui"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.11"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0",
		"chalk": "6.0.0"
	}
}

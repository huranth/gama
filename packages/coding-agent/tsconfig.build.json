{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@huranth/chord": ["../chord/dist/index.d.ts"],
			"@huranth/chord/bundler": ["../chord/dist/bundler.d.ts"],
			"@huranth/chord/node": ["../chord/dist/node.d.ts"],
			"@huranth/gama-agent-core": ["../agent/dist/index.d.ts"],
			"@huranth/gama-agent-core/*": ["../agent/dist/*.d.ts"],
			"@huranth/gama-ai": ["../ai/dist/index.d.ts"],
			"@huranth/gama-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@huranth/gama-tui": ["../tui/dist/index.d.ts"],
			"@huranth/gama-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}

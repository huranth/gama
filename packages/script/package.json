{
	"name": "@huranth/gama-codemode",
	"version": "1.0.2",
	"private": true,
	"description": "Sandboxed scripts with injected tools",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types": {
			"source": "./src/types.ts",
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./tools": {
			"source": "./src/tools.ts",
			"types": "./dist/tools.d.ts",
			"import": "./dist/tools.js"
		},
		"./worker": {
			"source": "./src/sandbox/worker.ts",
			"types": "./dist/sandbox/worker.d.ts",
			"import": "./dist/sandbox/worker.js"
		},
		"./declarations": {
			"source": "./src/types.ts",
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./source": {
			"source": "./src/tools.ts",
			"types": "./dist/tools.d.ts",
			"import": "./dist/tools.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"gama",
		"codemode",
		"sandbox",
		"quickjs",
		"wasm"
	],
	"author": "huranth",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/huranth/gama.git",
		"directory": "packages/script"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"quickjs-wasi": "3.6.2"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.11"
	}
}

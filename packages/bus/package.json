{
	"name": "@huranth/gama-bus",
	"version": "1.0.3",
	"private": true,
	"description": "Service composition and replicated state",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./context": {
			"source": "./src/scope/index.ts",
			"types": "./dist/scope/index.d.ts",
			"import": "./dist/scope/index.js"
		},
		"./delta": {
			"source": "./src/patch/index.ts",
			"types": "./dist/patch/index.d.ts",
			"import": "./dist/patch/index.js"
		},
		"./bundler": {
			"source": "./src/bundler.ts",
			"types": "./dist/bundler.d.ts",
			"import": "./dist/bundler.js"
		},
		"./node": {
			"source": "./src/host.ts",
			"types": "./dist/host.d.ts",
			"import": "./dist/host.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"application",
		"plugins",
		"rpc",
		"services",
		"state"
	],
	"author": "huranth",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/huranth/gama.git",
		"directory": "packages/bus"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"esbuild": "0.28.2"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.11"
	}
}
